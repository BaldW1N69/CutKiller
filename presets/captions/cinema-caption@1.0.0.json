{
  "name": "cinema-caption",
  "version": "1.0.0",
  "kind": "captions",
  "description": "Sous-titre cinématique vertical (9:16) : 2 à 4 mots en casse normale, Poppins SemiBold blanc cassé, mot prononcé à peine plus chaud, contour fin, ombre douce, apparition en fondu.",
  "params": {
    "font": { "file": "assets/fonts/poppins/Poppins-SemiBold.ttf", "family": "Poppins", "weight": "600" },
    "sizeRel": 0.032,
    "lineHeight": 1.2,
    "uppercase": false,
    "stripPunctuation": true,
    "fill": "#F5F2EB",
    "activeFill": "#FFD9A0",
    "stroke": { "color": "#000000", "widthRel": 0.12 },
    "shadow": { "color": "rgba(0,0,0,0.6)", "blurRel": 0.18, "offsetYRel": 0.04 },
    "entry": "caption-fade@1"
  }
}
