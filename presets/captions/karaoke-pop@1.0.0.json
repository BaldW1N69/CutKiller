{
  "name": "karaoke-pop",
  "version": "1.0.0",
  "kind": "captions",
  "description": "Format court : 1 à 3 mots en capitales, Poppins ExtraBold blanc à contour noir épais, mot prononcé en jaune, apparition en pop (ressort).",
  "params": {
    "font": { "file": "assets/fonts/poppins/Poppins-ExtraBold.ttf", "family": "Poppins", "weight": "800" },
    "sizeRel": 0.042,
    "lineHeight": 1.15,
    "uppercase": true,
    "stripPunctuation": true,
    "fill": "#FFFFFF",
    "activeFill": "#FFE14D",
    "stroke": { "color": "#000000", "widthRel": 0.2 },
    "shadow": { "color": "rgba(0,0,0,0.55)", "blurRel": 0.12, "offsetYRel": 0.06 },
    "entry": "caption-pop@1"
  }
}
