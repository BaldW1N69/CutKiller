{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "format": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "short",
            "long"
          ]
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fps": {
          "anyOf": [
            {
              "type": "number",
              "const": 30
            },
            {
              "type": "number",
              "const": 60
            }
          ]
        }
      },
      "required": [
        "kind",
        "width",
        "height",
        "fps"
      ]
    },
    "export": {
      "type": "object",
      "properties": {
        "codec": {
          "default": "h264",
          "type": "string",
          "enum": [
            "h264",
            "h265"
          ]
        },
        "minBitrateMbps": {
          "type": "object",
          "properties": {
            "30": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "60": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "30",
            "60"
          ]
        },
        "targetBitrateFactor": {
          "default": 1.25,
          "type": "number",
          "minimum": 1
        },
        "allowedFps": {
          "default": [
            30,
            60
          ],
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "blackPixelThreshold": {
          "default": 0.1,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "minBitrateMbps"
      ]
    },
    "montage": {
      "type": "object",
      "properties": {
        "maxSilenceMs": {
          "default": 350,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "wordMarginMs": {
          "default": [
            80,
            120
          ],
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "jlCutFrames": {
          "default": [
            4,
            12
          ],
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "beatToleranceFrames": {
          "default": 1,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxStaticShotS": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "punchInScale": {
          "default": [
            1.05,
            1.15
          ],
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "zoomCutLevels": {
          "default": [
            1.08,
            1.12,
            1.06,
            1.1
          ],
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1
          }
        },
        "minShotS": {
          "default": 1.2,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fillerWords": {
          "default": [
            "euh",
            "heu",
            "euhm",
            "hum",
            "hmm",
            "mmh",
            "bah",
            "ben",
            "beh"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contextualFillers": {
          "default": [
            "donc",
            "bon",
            "alors",
            "voilà",
            "enfin",
            "genre",
            "en fait",
            "du coup"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contextualPauseMs": {
          "default": 250,
          "type": "number",
          "minimum": 0
        },
        "repetitionMaxWords": {
          "default": 4,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "maxStaticShotS"
      ]
    },
    "motion": {
      "type": "object",
      "properties": {
        "microDurationMs": {
          "default": [
            150,
            300
          ],
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "transitionDurationMs": {
          "default": [
            200,
            500
          ],
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "motionBlurThresholdPxPerFrame": {
          "default": 12,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "overshoot": {
          "default": [
            0.03,
            0.08
          ],
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "punchLevels": {
          "default": [
            1.06,
            1.1,
            1.13
          ],
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1
          }
        },
        "punchPreset": {
          "default": "zoom-punch@1",
          "type": "string"
        },
        "punchMinSpacingS": {
          "default": 3,
          "type": "number",
          "minimum": 0
        },
        "emphasisMinScore": {
          "default": 1.2,
          "type": "number"
        },
        "emphasisWords": {
          "default": [
            "vraiment",
            "jamais",
            "toujours",
            "énorme",
            "énormes",
            "énormément",
            "incroyable",
            "majeur",
            "majeure",
            "absolument",
            "totalement",
            "complètement",
            "extrêmement",
            "surtout",
            "exactement",
            "impossible",
            "essentiel",
            "essentielle",
            "important",
            "importante",
            "seul",
            "seule",
            "tous",
            "toutes",
            "rien",
            "personne",
            "beaucoup",
            "énorme",
            "fou",
            "folle",
            "dingue",
            "génial",
            "parfait",
            "pire",
            "meilleur"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stopWords": {
          "default": [
            "le",
            "la",
            "les",
            "l'",
            "un",
            "une",
            "des",
            "du",
            "de",
            "d'",
            "à",
            "au",
            "aux",
            "et",
            "ou",
            "mais",
            "donc",
            "or",
            "ni",
            "car",
            "que",
            "qu'",
            "qui",
            "quoi",
            "dont",
            "où",
            "ce",
            "c'est",
            "ça",
            "cela",
            "il",
            "elle",
            "ils",
            "elles",
            "on",
            "je",
            "j'",
            "tu",
            "nous",
            "vous",
            "me",
            "te",
            "se",
            "s'",
            "en",
            "y",
            "ne",
            "n'",
            "pas",
            "est",
            "sont",
            "a",
            "ai",
            "as",
            "avait",
            "être",
            "avoir",
            "pour",
            "par",
            "sur",
            "dans",
            "avec",
            "sans",
            "sous",
            "chez",
            "mon",
            "ma",
            "mes",
            "ton",
            "ta",
            "tes",
            "son",
            "sa",
            "ses",
            "notre",
            "nos",
            "votre",
            "vos",
            "leur",
            "leurs",
            "cette",
            "ces",
            "cet",
            "si",
            "comme",
            "alors",
            "bon",
            "voilà"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transitions": {
          "default": {
            "sameSource": [
              "whip-pan@1"
            ],
            "crossSource": [
              "smooth-slide@1"
            ],
            "minSpacingS": 10,
            "minRemovedS": 1.2
          },
          "type": "object",
          "properties": {
            "sameSource": {
              "default": [
                "whip-pan@1"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "crossSource": {
              "default": [
                "smooth-slide@1"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "minSpacingS": {
              "default": 10,
              "type": "number",
              "minimum": 0
            },
            "minRemovedS": {
              "default": 1.2,
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "captions": {
      "type": "object",
      "properties": {
        "wordsPerScreen": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "maxLines": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxCharsPerLine": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxSyncErrorFrames": {
          "default": {
            "p95": 1,
            "max": 3
          },
          "type": "object",
          "properties": {
            "p95": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "p95",
            "max"
          ]
        },
        "minContrast": {
          "default": 4.5,
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "integratedLufs": {
          "default": -14,
          "type": "number"
        },
        "lufsTolerance": {
          "default": 1,
          "type": "number",
          "minimum": 0
        },
        "truePeakDbtp": {
          "default": -1,
          "type": "number"
        },
        "duckingDb": {
          "default": [
            -18,
            -12
          ],
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "cutFadeMs": {
          "default": [
            5,
            10
          ],
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "sfxToleranceFrames": {
          "default": 1,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "required": [
    "id",
    "version",
    "format",
    "export",
    "montage",
    "motion",
    "captions",
    "audio"
  ]
}
